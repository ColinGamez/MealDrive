# GEMINI_API_KEY: Required for fridge analysis, recipe and meal-plan generation,
# meal swaps, and speech generation. This value is read by the Express server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional public URL for hosted environments and callback links.
APP_URL="MY_APP_URL"

# PORT: Local server port used by the unified app + API server in development.
PORT="3000"

# Optional shopping-provider credentials. These are consumed only by the server
# route at /api/shopping/export and are never exposed to the browser bundle.
INSTACART_API_KEY="MY_INSTACART_API_KEY"
RAKUTEN_APPLICATION_ID="MY_RAKUTEN_APPLICATION_ID"
RAKUTEN_ACCESS_KEY="MY_RAKUTEN_ACCESS_KEY"
NAVER_CLIENT_ID="MY_NAVER_CLIENT_ID"
NAVER_CLIENT_SECRET="MY_NAVER_CLIENT_SECRET"
